---
/* src/components/CartaLangSelect.astro */
---

<div class="lang-select-wrapper fade-in">
  <div class="logo-container">
    <img src="/carta/logo.webp" alt="La Lucha Sanguchería" class="logo" />
  </div>

  <div class="button-group slide-up">
    <a href="/carta/es" class="lang-btn" aria-label="Ver nuestra carta">
      <img src="/carta/boton1.webp" alt="NUESTRA CARTA" class="btn-img" />
    </a>
    <a href="/carta/en" class="lang-btn" aria-label="View menu in English">
      <img src="/carta/boton2.webp" alt="CARTA ENGLISH" class="btn-img" />
    </a>
  </div>

  <div class="footer-note">
    <img src="/carta/texto.webp" alt="*Disponibilidad de productos de acuerdo a tienda. *Todas las imágenes mostradas en nuestra página web son referenciales." class="footer-img" />
  </div>
</div>

<style>
  .lang-select-wrapper {
    min-height: 100vh;
    min-height: 100dvh;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: #ffffff;
    padding: 3rem 1.5rem 1.5rem;
  }

  .logo-container {
    width: clamp(260px, 78vw, 380px);
    margin-top: clamp(5rem, 24vh, 8rem);
  }

  .logo {
    width: 100%;
    height: auto;
    display: block;
  }

  .button-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
    width: 100%;
    max-width: 250px;
    margin-top: clamp(5rem, 20vh, 7.5rem);
  }

  .lang-btn {
    display: block;
    width: 100%;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      filter 0.3s ease;
  }

  .lang-btn:hover,
  .lang-btn:active {
    transform: scale(1.03);
    filter: brightness(0.97);
  }

  .btn-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .footer-note {
    margin-top: auto;
    padding-top: 2rem;
    width: 100%;
    max-width: 360px;
    display: flex;
    justify-content: center;
  }

  .footer-img {
    width: 100%;
    height: auto;
    display: block;
    opacity: 0.85;
  }

  @media (max-height: 650px) {
    .logo-container {
      margin-top: 1.5rem;
    }
    .button-group {
      margin-top: 2rem;
    }
  }
</style>
